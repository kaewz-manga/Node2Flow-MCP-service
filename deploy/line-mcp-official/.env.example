# LINE Channel Access Token (required)
# Get from: https://developers.line.biz/console/
CHANNEL_ACCESS_TOKEN=your-channel-access-token

# Default destination user ID (optional)
DESTINATION_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth token for the HTTP bridge (optional, recommended)
# Set any random string to protect the endpoint
AUTH_TOKEN=your-random-auth-token
